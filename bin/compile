#!/usr/bin/env bash
#
# compile — Build a pnpm monorepo workspace package for Scalingo deployment.
#
# BUILD_DIR is the PROJECT_DIR (e.g. apps/server).  We navigate up to the
# monorepo root for pnpm operations, then deploy back into BUILD_DIR.
#
# Usage: bin/compile <BUILD_DIR> <CACHE_DIR> <ENV_DIR>

set -o errexit
set -o pipefail

BUILD_DIR="${1:-}"
CACHE_DIR="${2:-}"
ENV_DIR="${3:-}"

# ----- helpers ---------------------------------------------------------------

export_env_dir() {
  local env_dir="${1}"
  if [ -d "${env_dir}" ]; then
    pushd "${env_dir}" >/dev/null
    for e in *; do
      [ -e "${e}" ] || continue
      export "${e}=$(cat "${e}")"
    done
    popd >/dev/null
  fi
}

indent() {
  sed -u 's/^/       /'
}

header() {
  echo ""
  echo "-----> ${*}"
}

# Resolve the monorepo root by walking up from BUILD_DIR until we find
# pnpm-workspace.yaml.
find_root() {
  local dir="${1}"
  while [ "${dir}" != "/" ]; do
    if [ -f "${dir}/pnpm-workspace.yaml" ]; then
      echo "${dir}"
      return 0
    fi
    dir=$(dirname "${dir}")
  done
  return 1
}

# ----- export env vars -------------------------------------------------------
export_env_dir "${ENV_DIR}"

# ----- resolve directories ---------------------------------------------------

ROOT_DIR=$(find_root "${BUILD_DIR}")
if [ -z "${ROOT_DIR}" ]; then
  header "ERROR: could not find pnpm-workspace.yaml above ${BUILD_DIR}"
  exit 1
fi

PNPM_FILTER=$(jq -r '.name // empty' "${BUILD_DIR}/package.json")
if [ -z "${PNPM_FILTER}" ]; then
  header "ERROR: could not read package name from ${BUILD_DIR}/package.json"
  exit 1
fi

header "Deploying workspace package: ${PNPM_FILTER}"

# ----- install Node.js -------------------------------------------------------
# Reads the exact version from engines.node in package.json, then resolves
# the latest matching patch from the Node.js release index.

NODE_VERSION=$(jq -r '.engines.node // "22"' "${ROOT_DIR}/package.json")
NODE_DIR="${ROOT_DIR}/.scalingo/node"

if [ ! -f "${NODE_DIR}/bin/node" ]; then
  header "Installing Node.js ${NODE_VERSION}"
  mkdir -p "${NODE_DIR}"

  NODE_FULL=$(curl -sSf --retry 3 "https://nodejs.org/download/release/index.json" \
    | jq -r "[.[].version[1:]] | map(select(startswith(\"${NODE_VERSION}.\"))) | first // empty" 2>/dev/null)

  if [ -z "${NODE_FULL}" ]; then
    header "ERROR: could not resolve Node.js ${NODE_VERSION}"
    exit 1
  fi

  echo "Downloading Node.js ${NODE_FULL}..." | indent
  curl -sSf --retry 3 --connect-timeout 10 \
    "https://nodejs.org/dist/v${NODE_FULL}/node-v${NODE_FULL}-linux-x64.tar.gz" \
    | tar xz --strip-components=1 -C "${NODE_DIR}" 2>&1 | indent
  echo "Node.js $( "${NODE_DIR}/bin/node" --version ) installed" | indent
fi

export PATH="${NODE_DIR}/bin:${PATH}"

# ----- install pnpm ----------------------------------------------------------
header "Installing pnpm"

corepack enable pnpm 2>&1 | indent
echo "pnpm $(pnpm --version)" | indent

# ----- install dependencies --------------------------------------------------
header "Installing dependencies"

cd "${ROOT_DIR}"
pnpm install --frozen-lockfile 2>&1 | indent

# ----- build -----------------------------------------------------------------
header "Building application"

pnpm --filter="${PNPM_FILTER}" run build 2>&1 | indent

# ----- deploy ----------------------------------------------------------------

DEPLOY_DIR="/tmp/pnpm-deploy"
rm -rf "${DEPLOY_DIR}"
mkdir -p "${DEPLOY_DIR}"

if [ -d "${BUILD_DIR}/.next/standalone" ]; then
  # Next.js standalone mode — the build already produced a self-contained
  # output with its own node_modules.  No pnpm deploy needed.
  # In a monorepo, node_modules lives at .next/standalone/node_modules/,
  # not inside the app subdirectory — copy the full tree.
  header "Using Next.js standalone output"
  cp -r "${BUILD_DIR}/.next/standalone"/. "${DEPLOY_DIR}/"
else
  # Regular Node app — use pnpm deploy for production-only dependencies.
  header "Creating production deployment (pnpm deploy)"

  pnpm --filter="${PNPM_FILTER}" --prod deploy "${DEPLOY_DIR}" 2>&1 | indent

  # pnpm deploy leaves a content-addressable store (.local) and build caches
  # (.cache) inside the deploy output.  They're not needed at runtime.
  rm -rf "${DEPLOY_DIR}/.local" "${DEPLOY_DIR}/.cache"
fi

# The standalone output doesn't include the Procfile — copy it from the source.
if [ -f "${BUILD_DIR}/Procfile" ] && [ ! -f "${DEPLOY_DIR}/Procfile" ]; then
  cp "${BUILD_DIR}/Procfile" "${DEPLOY_DIR}/"
fi

# ----- finalize --------------------------------------------------------------
header "Finalizing deployment"

# Save the Node.js binary, wipe the entire monorepo, then recreate BUILD_DIR
# from the deploy output.
mv "${ROOT_DIR}/.scalingo" "/tmp/.scalingo-save" 2>/dev/null || true

# cd out of ROOT_DIR before deleting it — rm -rf on the CWD is unreliable
cd /
rm -rf "${ROOT_DIR}"
mkdir -p "${BUILD_DIR}"

mv "/tmp/.scalingo-save" "${BUILD_DIR}/.scalingo" 2>/dev/null || true

# dotglob: make * match hidden files (.next/, .profile.d/, etc.)
shopt -s dotglob
mv "${DEPLOY_DIR}"/* "${BUILD_DIR}/"
rm -rf "${DEPLOY_DIR}"

# .profile.d/ scripts are sourced at container boot — use one to put our
# Node.js binary on PATH.
mkdir -p "${BUILD_DIR}/.profile.d"
cat > "${BUILD_DIR}/.profile.d/node.sh" << 'SCRIPT'
export PATH="/app/.scalingo/node/bin:$PATH"
SCRIPT

header "Deployment ready"
